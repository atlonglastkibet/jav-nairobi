    if is_polars:
        df = df.with_columns(
            pl.col('ward').replace_strict(area_dict, default=0.0, return_dtype=pl.Float64).alias('area_km2')
        )
    else:
        df['area_km2'] = df['ward'].map(area_dict).fillna(0.0)
    print("✓ Added area_km2 from wards_nairobi_gdf")
else:
    print("Warning: wards_nairobi_gdf missing; skipping area-based metrics.")
    if is_polars:
        df = df.with_columns(pl.lit(1.0).alias('area_km2'))
    else:
        df['area_km2'] = 1.0

# 1. Trip density
if 'outgoing_trips' in df.columns and 'area_km2' in df.columns:
    if is_polars:
        df = df.with_columns(
            pl.when(pl.col('area_km2') > 0)
             .then(pl.col('outgoing_trips') / pl.col('area_km2'))
             .otherwise(0.0)
             .alias('trip_density')
        )
    else:
        df['trip_density'] = np.where(df['area_km2'] > 0, df['outgoing_trips'] / df['area_km2'], 0)
    print("✓ Added trip_density")

# 2. Demand-supply ratio
if 'trips_per_hour' in df.columns and 'outgoing_trips' in df.columns:
    if is_polars:
        df = df.with_columns(
            pl.when(pl.col('trips_per_hour') > 0)
             .then(pl.col('outgoing_trips') / (pl.col('trips_per_hour') + 1e-6))
             .otherwise(0.0)
             .alias('demand_supply_ratio')
        )
    else:
        df['demand_supply_ratio'] = np.where(df['trips_per_hour'] > 0, df['outgoing_trips'] / df['trips_per_hour'], 0)
    print("✓ Added demand_supply_ratio")

# 3. Activity ratio
if 'population' in df.columns and 'active_population' in df.columns:
