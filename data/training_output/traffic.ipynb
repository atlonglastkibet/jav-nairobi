# %%
import polars as pl

print("Aggregating trip intensities...")

# Convert to Polars if not already
trips_pl = pl.from_pandas(trips_df)

# Count movements per cell per hour (both as origin and destination)
movement_intensity = (
    trips_pl
    .group_by(["hour", "origin_cell"])
    .agg(pl.count().alias("departures"))
    .join(
        trips_pl.group_by(["hour", "dest_cell"])
                .agg(pl.count().alias("arrivals")),
        left_on=["hour", "origin_cell"],
        right_on=["hour", "dest_cell"],
        how="outer"
    )
    .fill_null(0)
    .with_columns([
        (pl.col("departures") + pl.col("arrivals")).alias("total_flows"),
        pl.when(pl.col("origin_cell").is_not_null())
          .then(pl.col("origin_cell"))
          .otherwise(pl.col("dest_cell"))
          .alias("cell_id")
    ])
    .select(["hour", "cell_id", "total_flows"])
)

