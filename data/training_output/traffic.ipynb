print("-"*60)

if is_polars:
    # Fill numeric columns (vectorized)
    fill_exprs = [pl.col(c).fill_null(0).alias(c) for c in existing_mobility]
    if fill_exprs:
        df = df.with_columns(fill_exprs)
        print(f"✓ Filled {len(existing_mobility)} numeric columns with 0")
    else:
        print("⚠️  No numeric columns to fill")
else:
    filled_count = 0
    for col in existing_mobility:
        before_fill = df[col].isnull().sum()
        if before_fill > 0:
            df[col] = df[col].fillna(0)
            print(f"  Filled {before_fill} nulls in '{col}'")
            filled_count += 1
    
    if filled_count == 0:
        print("✓ No numeric columns needed filling")
    else:
        print(f"\n✓ Filled {filled_count} numeric columns with 0")

# =============================================================================
# 3. INFER CONGESTION FROM SPEED (IF MISSING)
# =============================================================================
print("\n3. INFERRING MISSING CONGESTION FROM SPEED")
print("-"*60)

if is_polars and 'dominant_congestion' in df.columns and 'avg_speed_kmh' in df.columns:
    # Count missing before inference
    missing_before = df['dominant_congestion'].null_count()
    
    if missing_before > 0:
        # Infer congestion level from speed (Google Maps style)
        congestion_inference = (
            pl.when(pl.col('avg_speed_kmh') >= 30).then(pl.lit(['free_flow']))
            .when(pl.col('avg_speed_kmh') >= 20).then(pl.lit(['moderate']))
            .when(pl.col('avg_speed_kmh') >= 10).then(pl.lit(['congested']))
            .when(pl.col('avg_speed_kmh') > 0).then(pl.lit(['heavily_congested']))
            .otherwise(pl.lit(['unknown']))
        )
        
        # Fill nulls with inferred values
        df = df.with_columns(
            pl.when(pl.col('dominant_congestion').is_null())
            .then(congestion_inference)
            .otherwise(pl.col('dominant_congestion'))
            .alias('dominant_congestion')
        )
        
        missing_after = df['dominant_congestion'].null_count()
        inferred_count = missing_before - missing_after
        print(f"✓ Inferred congestion for {inferred_count} rows from avg_speed_kmh")
        
        # Show distribution of inferred congestion
        inferred_dist = (
            df.filter(pl.col('avg_speed_kmh') > 0)
            .select(pl.col('dominant_congestion').list.first().alias('congestion'))
            .group_by('congestion')
            .len()
            .sort('len', descending=True)
        )
        print("\nCongestion distribution (after inference):")
        print(inferred_dist.to_pandas().to_string(index=False))
    else:
        print("✓ No missing congestion values to infer")
elif not is_polars:
    # Pandas version
    if 'dominant_congestion' in df.columns and 'avg_speed_kmh' in df.columns:
        missing_before = df['dominant_congestion'].isnull().sum()
        
        if missing_before > 0:
            def infer_congestion(speed):
                if pd.isna(speed) or speed == 0:
                    return ['unknown']
                elif speed >= 30:
                    return ['free_flow']
                elif speed >= 20:
                    return ['moderate']
                elif speed >= 10:
                    return ['congested']
                else:
                    return ['heavily_congested']
            
            # Apply inference only to null values
            mask = df['dominant_congestion'].isnull()
            df.loc[mask, 'dominant_congestion'] = df.loc[mask, 'avg_speed_kmh'].apply(infer_congestion)
            
            missing_after = df['dominant_congestion'].isnull().sum()
            print(f"✓ Inferred congestion for {missing_before - missing_after} rows from avg_speed_kmh")

# =============================================================================
