# Cell 13: Ward-Hour Mobility Aggregation (Fixed Net Flow)
import polars as pl

target_hours = [6, 9, 15]
trips_filtered_pl = trips_pl.filter(pl.col('hour').is_in(target_hours)) if target_hours else trips_pl
print(f"Trips in hours {target_hours if target_hours else 'all'}: {len(trips_filtered_pl):,}")

# Outgoing aggregation
outgoing_pl = trips_filtered_pl.group_by(['origin_ward', 'hour']).agg([
    pl.len().alias('outgoing_trips'),
    pl.col('agent_id').n_unique().alias('unique_agents'),
    pl.col('dest_ward').n_unique().alias('destination_diversity'),
    pl.col('speed_kmh').mean().alias('avg_speed_kmh'),
    pl.col('speed_ratio').mean().alias('avg_speed_ratio'),
    pl.col('duration_h').mean().alias('avg_duration_h'),
    pl.col('congestion_level').mode().alias('dominant_congestion'),
    (pl.col('congestion_level').is_in(['congested', 'heavily_congested']).sum() / pl.len() * 100).alias('congestion_pct')
]).sort(['origin_ward', 'hour'])

outgoing_pl = outgoing_pl.with_columns(pl.col('origin_ward').alias('ward'))

# Incoming aggregation
incoming_pl = trips_filtered_pl.group_by(['dest_ward', 'hour']).agg([
    pl.len().alias('incoming_trips')
]).sort(['dest_ward', 'hour'])

incoming_pl = incoming_pl.with_columns(pl.col('dest_ward').alias('ward'))

# Outer merge
ward_hour_mobility_pl = outgoing_pl.join(incoming_pl, on=['ward', 'hour'], how='full', suffix='_incoming')
ward_hour_mobility_pl = ward_hour_mobility_pl.fill_null(0)

# Fix net_flow calculation: cast to signed integer first
ward_hour_mobility_pl = ward_hour_mobility_pl.with_columns([
    pl.col('outgoing_trips').cast(pl.Int64).alias('outgoing_trips'),
    pl.col('incoming_trips').cast(pl.Int64).alias('incoming_trips')
])

ward_hour_mobility_pl = ward_hour_mobility_pl.with_columns(
    (pl.col('outgoing_trips') - pl.col('incoming_trips')).alias('net_flow')
)

print(f"Ward-hour mobility rows: {len(ward_hour_mobility_pl):,}")
print("Sample (head 10):")
print(ward_hour_mobility_pl.head(10).to_pandas().to_string(index=False))

ward_hour_mobility_df = ward_hour_mobility_pl.to_pandas()
print("\nAggregation complete.")

