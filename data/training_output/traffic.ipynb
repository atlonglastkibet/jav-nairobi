        df = df.with_columns(
            pl.when(pl.col('population') > 0)
             .then(pl.col('active_population') / (pl.col('population') + 1e-6))
             .otherwise(0.0)
             .alias('density_ratio')
        )
    else:
        df['density_ratio'] = np.where(df['population'] > 0, df['active_population'] / df['population'], 0)
    print("✓ Added density_ratio")

